@using ExpressVoitures.Resources.Views.Shared
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExpressVoitures</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.min.css">
    <link rel="stylesheet" href="https://unpkg.com/dropzone@5/dist/min/dropzone.min.css" type="text/css" />
    <link rel="stylesheet" href="~/css/manufacturer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AddCarAdmin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpressVoitures.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preload" href="/images/fondco.png" as="image" />
</head>
<body>
    @if (ViewBag.FromAddCar != true)
{
    <header class="ev-full-width ev-header">
        <div class="ev-content ev-header-content">
            <div class="ev-logo">
                Express Voitures
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <a class="ev-nav-btn" asp-controller="Home" asp-action="Index" title=@LayoutViewResources.Home>
                    <i class="bi-house"></i>
                    @LayoutViewResources.Home
                </a>
                <a class="ev-nav-btn" asp-controller="CarListView" asp-action="CarList" title=@LayoutViewResources.OurCars>
                    <i class="bi-car-front"></i>
                    @LayoutViewResources.OurCars
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                        <a class="ev-nav-btn" asp-controller="CarAdmin" asp-action="AddCarAdminIndex" title=@LayoutViewResources.AddCar>
                        <i class="bi bi-plus-circle"></i>
                        @LayoutViewResources.AddCar
                        </a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="ev-nav-btn-admin" asp-controller="Dashboard" asp-action="DashboardIndex" title=@LayoutViewResources.GoToAdmin>
                        <i class="bi bi-gear"></i>
                        @LayoutViewResources.GoToAdmin
                    </a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="ev-nav-btn-admin" title=@LayoutViewResources.Logout>
                            <i class="bi-box-arrow-right"></i>
                        </button>
                    </form>
                }
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="ev-nav-btn-admin" asp-controller="Account" asp-action="Login" title=@LayoutViewResources.Login>
                        <i class="bi-box-arrow-in-right"></i>
                        @LayoutViewResources.Login
                    </a>
                }
            </div>
        </div>
    </header>
    }
    else
    {
        <div class="ev-manufacturerFromAddCar-header">
            <a href="/CarAdmin/AddCarAdminIndex"><i class="bi-arrow-left"></i> Retour au formulaire du véhicule</a>
        </div>
    }
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>
    @if (ViewBag.FromAddCar != true)
    {
    <footer class="border-top footer text-muted">
        <div class="ev-full-width ev-content">
            &copy; 2026 - ExpressVoitures - OPENCLASSROOMS - Projet 5 - Jaegle Jérome
        </div>
    </footer>
    }
    else
    {
        <div class="ev-manufacturerFromAddCar-header">
        </div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="https://unpkg.com/dropzone@5/dist/min/dropzone.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
