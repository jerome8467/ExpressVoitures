<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExpressVoitures</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpressVoitures.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preload" href="/images/fondco.png" as="image" />
</head>
<body>
    <header class="ev-full-width ev-header">
        <div class="ev-content ev-header-content">
            <div class="ev-logo">
                Express Voitures
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <a class="ev-nav-btn" asp-controller="Home" asp-action="Index" title="Acccueil">
                    <i class="bi-house"></i>
                    ACCUEIL
                </a>
                <a class="ev-nav-btn" asp-controller="Home" asp-action="CarList" title="Nos voitures">
                    <i class="bi-car-front"></i>
                    NOS VOITURES
                </a>
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="ev-nav-btn" asp-controller="Car" asp-action="Create" title="Ajouter un véhicule">
                        <i class="bi bi-plus-circle"></i>
                        AJOUTER UNE VOITURE
                    </a>
                }
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="ev-nav-btn-admin" asp-controller="Admin" asp-action="Dashboard" title="Panneau d'administration">
                        <i class="bi bi-gear"></i>
                        ADMINISTRATION
                    </a>
                }
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="ev-nav-btn-admin" asp-controller="Admin" asp-action="AccountController" title="Se déconnecter">
                        <i class="bi-box-arrow-right"></i>
                    </a>
                }
                @if (!User.Identity.IsAuthenticated)
                {
                    <a class="ev-nav-btn-admin" asp-controller="Account" asp-action="Login" title="Se connecter">
                        <i class="bi-box-arrow-in-right"></i>
                        SE CONNECTER
                    </a>
                }
            </div>
        </div>
    </header>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="ev-full-width ev-content">
            &copy; 2026 - ExpressVoitures - OPENCLASSROOMS - Projet 5 - Jaegle Jérome
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
