@using ExpressVoitures.Resources.Views.Home

@{
    ViewData["Title"] = "Home Page";
}

<div class="ev-page-index">
    <div class="ev-index-row">
        <div class="ev-index-col-side alignLeft-img slideLeft-img">
            <img src="~/images/gauche.png" class="alignRight-img" alt="image gauche" />
        </div>
        <div class="ev-index-col-center">
            <div>
                <div class=" ev-indexCenter-title slideBottom">
                <a>
                    Express Voiture
                </a>
                </div>
                <div class="ev-indexSlogan slideTop">
                <a>
                        @HomeViewResources.Slogan
                </a>
                </div>
            </div>
            
            <div class="ev-indexCenter-content FadeIn">
                <a>@HomeViewResources.Description</a>
            </div>
            <div >
                <div class="ZoomIn">
                    <a class="ev-indexCenter-btn" asp-controller="CarListView" asp-action="CarList" title="Voir nos voitures">
                    <i class="bi-car-front"></i>
                        @HomeViewResources.SeeOurCars
                    </a>
                </div>
            </div>
        </div>
        <div class="ev-index-col-side alignRight-img slideRight-img">
            <img src="~/images/droite.png" class="alignLeft-img" alt="image droite" />
        </div>
    </div>
</div>

