@using ExpressVoitures.Resources.Views.Account
@model ExpressVoitures.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Account Page";
}


<div class="ev-page-Login">
    <div class="ev-Login-col  FadeIn">
        <div class="ev-titleLogin">
            <a>@LoginViewResources.Title</a>
        </div>
        <form asp-action="Login" asp-controller="Account" method="post">
            

            <div class="ev-container-form">
                <label asp-for="Email">@LoginViewResources.Email</label>
                <input asp-for="Email" class="ev-form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="ev-container-form">
                <label asp-for="Password">@LoginViewResources.Password</label>
                <input asp-for="Password" class="ev-form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button class="ev-loginBtn" type="submit"><i class="bi-box-arrow-in-right"></i>@LoginViewResources.Submit</button>
            <div class="text-danger mt-4 ev-formLogin" style="text-align:center;" asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="ReturnUrl" />
        </form>
    </div>
</div>